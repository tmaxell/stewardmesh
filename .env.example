# Copy to .env for local overrides. Never commit real credentials.
POSTGRES_DB=stewardmesh
POSTGRES_USER=stewardmesh
POSTGRES_PASSWORD=stewardmesh-local
POSTGRES_PORT=5432

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=stewardmesh-local
STEWARDMESH_OAUTH_CLIENT_ID=stewardmesh-local
STEWARDMESH_OAUTH_CLIENT_SECRET=stewardmesh-local-secret

# Separate least-privilege MCP service accounts. Distinct subjects let the local stack show a
# proposer, an approver and an executor that cannot take each other's step.
STEWARDMESH_MCP_AGENT_CLIENT_ID=stewardmesh-agent
STEWARDMESH_MCP_AGENT_CLIENT_SECRET=stewardmesh-agent-secret
STEWARDMESH_MCP_STEWARD_CLIENT_ID=stewardmesh-steward
STEWARDMESH_MCP_STEWARD_CLIENT_SECRET=stewardmesh-steward-secret
STEWARDMESH_MCP_EXECUTOR_CLIENT_ID=stewardmesh-executor
STEWARDMESH_MCP_EXECUTOR_CLIENT_SECRET=stewardmesh-executor-secret
STEWARDMESH_JWK_SET_URI=http://localhost:8081/realms/stewardmesh/protocol/openid-connect/certs
STEWARDMESH_JWT_AUDIENCE=stewardmesh-master-data

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
STEWARDMESH_INTAKE_BUCKET=stewardmesh-intake
STEWARDMESH_MASTER_EVENTS_QUEUE=stewardmesh-master-events
STEWARDMESH_SOURCE_EVENTS_QUEUE=stewardmesh-source-events
STEWARDMESH_MESSAGING_ENABLED=true
STEWARDMESH_ALLOWED_EVENT_PRODUCERS=synthetic-distributor,nsi-distribution-service,master-data-service

# Optional Groq-backed reference-agent demo. Put GROQ_API_KEY only in the ignored .env file or
# export it in the shell; never add a key to this template.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1/
