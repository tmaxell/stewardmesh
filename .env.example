# Copy to .env for local overrides. Never commit real credentials.
POSTGRES_DB=stewardmesh
POSTGRES_USER=stewardmesh
POSTGRES_PASSWORD=stewardmesh-local
POSTGRES_PORT=5432

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=stewardmesh-local
STEWARDMESH_OAUTH_CLIENT_ID=stewardmesh-local
STEWARDMESH_OAUTH_CLIENT_SECRET=stewardmesh-local-secret
STEWARDMESH_JWK_SET_URI=http://localhost:8081/realms/stewardmesh/protocol/openid-connect/certs

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
STEWARDMESH_INTAKE_BUCKET=stewardmesh-intake
STEWARDMESH_MASTER_EVENTS_QUEUE=stewardmesh-master-events
STEWARDMESH_SOURCE_EVENTS_QUEUE=stewardmesh-source-events
